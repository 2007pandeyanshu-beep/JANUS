# JANUS Environment Configuration Example
# Copy this file to .env for local overrides (never commit .env)

# Server Configuration
JANUS_HOST=127.0.0.1
JANUS_PORT=8000
JANUS_DEBUG=True
JANUS_ENV=development

# Allowed CORS Origins (Frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: LLM Providers (Not required for Phase 1 deterministic ranking core)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
