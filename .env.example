# JANUS Environment Configuration Example
# Copy this file to .env for local overrides (never commit .env)

# Server Configuration
JANUS_HOST=127.0.0.1
JANUS_PORT=8000
JANUS_DEBUG=True
JANUS_ENV=development

# Allowed CORS Origins (Frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: LLM Providers (Not required for Phase 1 deterministic ranking core)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Fetch.ai uAgent & Agentverse Configuration
# Secure identity seed for deterministic, persistent agent address across restarts
# (Do NOT commit actual secret seeds to source control)
JANUS_AGENT_SEED=

# Mailbox Mode (Set to true to connect via Agentverse Mailbox instead of local HTTP endpoint)
JANUS_USE_MAILBOX=false

# Optional: Custom Agentverse endpoint URL override (defaults to standard https://agentverse.ai)
# AGENTVERSE_URL=https://agentverse.ai

# Independent Fetch.ai Auditor uAgent Configuration (Phase 3)
# Seed for independent auditor agent daemon (defaults to deterministic testing phrase if empty)
JANUS_AUDITOR_SEED=
JANUS_AUDITOR_PORT=8009
JANUS_AUDITOR_ADDRESS=agent1qtce9c74t0fmyy2las425v7rfzf8mvlgwjegcwwx5pmmnuxhfryqs8l7ylg
JANUS_AUDITOR_ENDPOINT=http://127.0.0.1:8009/submit
JANUS_AUDITOR_USE_MAILBOX=false
JANUS_AUDITOR_TIMEOUT=4.0

# Independent Fetch.ai Research uAgent Configuration (Phase 4)
JANUS_RESEARCH_AGENT_SEED=
JANUS_RESEARCH_AGENT_PORT=8010
JANUS_RESEARCH_AGENT_ADDRESS=agent1q0hhnepntx63ach7vr93q930wk8swxgntray6lvn4scujt2hj0dzzd9d0py
JANUS_RESEARCH_AGENT_ENDPOINT=http://127.0.0.1:8010/submit
JANUS_RESEARCH_AGENT_USE_MAILBOX=false
JANUS_RESEARCH_AGENT_TIMEOUT=5.0

# Independent Fetch.ai Hypothesis Analyst uAgent Configuration (Phase 5)
JANUS_HYPOTHESIS_ANALYST_SEED=
JANUS_HYPOTHESIS_ANALYST_PORT=8011
JANUS_HYPOTHESIS_ANALYST_ADDRESS=agent1qfmmvna5ff9nwgyq6r8p63c2pd82w8ashzghta3hs2zaawguj548xx0lk0d
JANUS_HYPOTHESIS_ANALYST_ENDPOINT=http://127.0.0.1:8011/submit
JANUS_HYPOTHESIS_ANALYST_USE_MAILBOX=false
JANUS_HYPOTHESIS_ANALYST_TIMEOUT_SECONDS=5.0

# Independent Fetch.ai Scientific Tool uAgent Configuration (Phase 6)
JANUS_SCIENTIFIC_TOOL_SEED=
JANUS_SCIENTIFIC_TOOL_PORT=8012
JANUS_SCIENTIFIC_TOOL_ADDRESS=agent1q2lmglm5n5nl8wxrcly6j4w0xts9fa9zh2u8qq8mxf30ya3mfxcpjq6md8t
JANUS_SCIENTIFIC_TOOL_ENDPOINT=http://127.0.0.1:8012/submit
JANUS_SCIENTIFIC_TOOL_USE_MAILBOX=false
JANUS_SCIENTIFIC_TOOL_TIMEOUT_SECONDS=5.0

# Independent Fetch.ai Experiment Designer uAgent Configuration (Phase 7)
JANUS_EXPERIMENT_DESIGNER_SEED=
JANUS_EXPERIMENT_DESIGNER_PORT=8013
JANUS_EXPERIMENT_DESIGNER_ADDRESS=agent1q0qpwtcrpp5cmehgwg2reypzk47qxt9mzhxulj9962qrdj9a8a40keavldj
JANUS_EXPERIMENT_DESIGNER_ENDPOINT=http://127.0.0.1:8013/submit
